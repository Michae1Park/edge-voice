# systemd unit for edge-voice. The app pings WATCHDOG=1 from the Supervisor; if pings stop
# (hang, deadlock, OOM), systemd restarts the unit.
#
# Install on the device: ./install.sh (templates the paths below), or `make install-service`
# after editing them by hand.
#
# Verify the watchdog fires:
#   sudo systemctl kill -s SIGSTOP edge-voice && journalctl -u edge-voice -f

[Unit]
Description=edge-voice — real-time dual-channel call transcription
After=network.target

# A restart cycle (WatchdogSec + RestartSec, ~13s) exceeds systemd's default 10s limit window,
# so widen it: 5 crashes in 5 minutes marks the unit failed instead of looping forever.
# Clear with `systemctl reset-failed edge-voice`.
StartLimitIntervalSec=300s
StartLimitBurst=5

[Service]
Type=notify

# Keep well above reliability.tick_interval_s (2s) so a missed tick doesn't trigger a restart.
WatchdogSec=10s

Restart=always
RestartSec=3s

# --- adjust these to the actual install ---
User=ai
WorkingDirectory=/home/ai/workspace/edge-voice
ExecStart=/home/ai/workspace/edge-voice/venv/bin/edge-voice

# Multi-threading one short inference was measured slower than single-threaded.
Environment=MOONSHINE_ORT_SINGLE_THREAD=1

NoNewPrivileges=true
ProtectSystem=strict
ReadWritePaths=/home/ai/workspace/edge-voice

[Install]
WantedBy=multi-user.target
